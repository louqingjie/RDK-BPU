# OE SDK 交付包不入库
oe_sdk/

# 第三方公开数据集（108 MB，按需本地下载，不入库）
RM2025-Armor-Public-Dataset/

# ============================================================
# data/ 白名单策略：默认全部忽略，只放行「目录骨架 + 元数据」
# 大体量二进制（模型、校准样本、可视化图）一律不入库
# ============================================================
data/*
# 两个子模块仓库（由各自远端独立版本管理）
!data/AT_NN_Detector
!data/rm_armor_detection
# RDK X5 量化工作区：跟踪 yaml / manifest / README
!data/horizon_x5/
# ONNX 落盘目录：只保留目录骨架
!data/onnx/

# 校准集：跟踪 manifest.csv 与 README.md，忽略样本本体
data/horizon_x5/data/calibration_data/images/
data/horizon_x5/data/calibration_data/source/
data/horizon_x5/data/calibration_data_640/
data/horizon_x5/data/calibration_data_640_u8/

# Python 缓存
__pycache__/
*.pyc

# 二进制与大文件
*.tar.gz
*.bin
*.onnx
*.hbm
*.hbir
*.avi
*.mp4
*.html
.trae/

# 量化编译工作目录（保留 config yaml，产物不入库）
quant/*/model_output/
quant/verifier_output/
hb_mapper_makertbin.log
hb_mapper_checker.log

# 量化检查器产物
.hb_check/
